* text=auto
.gitattributes text eol=lf

# Canonical repository text uses LF on every platform.
*.cfg text eol=lf
*.cff text eol=lf
*.csv text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Rendered and research-data artifacts are byte-preserving binary files.
*.gif binary
*.jpg binary
*.jpeg binary
*.npy binary
*.npz binary
*.parquet binary
*.pdf binary
*.png binary
*.pt binary
*.pth binary
